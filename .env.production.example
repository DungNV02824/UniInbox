# Mẫu env production — copy thành .env.production trên VPS (chmod 600) rồi điền giá trị thật.
# Dùng cho: docker compose -f docker-compose.prod.yml --env-file .env.production ...
# File này vừa để nội suy docker-compose.prod.yml, vừa là env_file cho migrate/api/worker.
# KHÔNG commit .env.production.
#
# Sinh chuỗi ngẫu nhiên:  openssl rand -hex 32        (JWT, mật khẩu, khóa S3)
#                          openssl rand -base64 32     (ENCRYPTION_KEY mới — nhưng xem ghi chú bên dưới)

# ===== Docker / compose =====
# Mạng của Caddy dùng chung trên VPS
EDGE_NETWORK=qspro_default
IMAGE_TAG=latest

# ===== Chung =====
NODE_ENV=production
APP_URL=https://alo.vuathau.com.vn
# API nằm sau tiền tố /api (Caddy bỏ /api trước khi chuyển tới api:4000).
# Webhook Meta + callback Facebook Login dựng từ biến này.
API_URL=https://alo.vuathau.com.vn/api
TZ=Asia/Ho_Chi_Minh
# 32 byte base64. PHẢI GIỐNG HỆT giá trị đang dùng ở dev nếu mang DB dev lên (token Page đã mã hóa bằng khóa này).
ENCRYPTION_KEY=__BASE64_32_BYTES__
# >= 32 ký tự, hai giá trị phải KHÁC nhau
JWT_SECRET=__RANDOM_HEX_64__
JWT_REFRESH_SECRET=__RANDOM_HEX_64_KHAC__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
LOG_LEVEL=info

# ===== Postgres (container dezon-inbox-db) =====
POSTGRES_USER=dezon
# Chỉ dùng ký tự an toàn cho URL (chữ/số, vd. openssl rand -hex 24)
POSTGRES_PASSWORD=__RANDOM_HEX__
POSTGRES_DB=dezon_inbox
# DATABASE_URL, REDIS_URL, S3_ENDPOINT do docker-compose.prod.yml tự đặt (ghi đè giá trị ở đây):
#   DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@dezon-inbox-db:5432/${POSTGRES_DB}
#   REDIS_URL=redis://dezon-inbox-redis:6379
#   S3_ENDPOINT=http://dezon-inbox-s3:8333

# ===== Lưu trữ tệp (SeaweedFS S3, container dezon-inbox-s3) =====
S3_BUCKET=dezon-inbox
# Khóa riêng cho production (KHÔNG dùng khóa dev dezon/dezon-s3-secret). Chỉ chữ/số.
S3_ACCESS_KEY=__RANDOM_HEX_20__
S3_SECRET_KEY=__RANDOM_HEX_40__
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# Trình duyệt mở URL ký qua https://alo.vuathau.com.vn/dezon-inbox/... (Caddy chuyển nguyên vẹn tới S3).
S3_PUBLIC_ENDPOINT=https://alo.vuathau.com.vn
MEDIA_MAX_UPLOAD_MB=10
MEDIA_SIGNED_URL_TTL_SEC=3600
SMTP_URL=

# ===== Seed (chỉ khi chạy lệnh seed tạo admin đầu tiên, xem docs/DEPLOY.md) =====
SEED_ADMIN_EMAIL=admin@dezon.vn
SEED_ADMIN_PASSWORD=__MAT_KHAU_ADMIN__
SEED_ADMIN_NAME=Quản trị Dezon
SEED_AGENT_EMAIL=
SEED_AGENT_PASSWORD=

# ===== AI =====
AI_PROVIDER=gemini
GEMINI_API_KEY=__GEMINI_API_KEY__
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
AI_MODEL_MAIN=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
AI_DEBOUNCE_MS=12000
AI_DEBOUNCE_MAX_WAIT_MS=45000
AI_PAUSE_AFTER_AGENT_MIN=30
AI_MIN_CONFIDENCE=0.6
AI_MAX_AUTO_REPLIES_PER_HOUR=20
AI_SEND_HOLDING_MESSAGE=false

# ===== Meta / Messenger =====
META_APP_ID=__META_APP_ID__
META_APP_SECRET=__META_APP_SECRET__
# Chuỗi tự đặt; nhập y hệt ở ô "Verify token" của webhook trong Meta App
META_VERIFY_TOKEN=__RANDOM_HEX__
META_GRAPH_VERSION=v26.0
META_HUMAN_AGENT_ENABLED=false
# Valid OAuth Redirect URI: https://alo.vuathau.com.vn/api/channels/messenger/oauth/callback
META_LOGIN_CONFIG_ID=
META_GRAPH_BASE_URL=https://graph.facebook.com
MESSENGER_HISTORY_DAYS=30
MESSENGER_SYNC_INTERVAL_SEC=60
META_LOGIN_DIALOG_BASE_URL=

# ===== Zalo OA =====
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET_KEY=
ZALO_OA_ALLOW_PAID_BOT=false
ZALO_OAUTH_BASE_URL=https://oauth.zaloapp.com
ZALO_OPENAPI_BASE_URL=https://openapi.zalo.me
ZALO_VERIFIER_DIR=./data/zalo-verifier
ZALO_SIGNATURE_TIMESTAMP_SOURCE=body
ZALO_SYNC_INTERVAL_SEC=60
ZALO_HISTORY_DAYS=7

# ===== Zalo cá nhân =====
ZALO_PERSONAL_ENABLED=false
ZALO_PERSONAL_MIN_SEND_INTERVAL_MS=3000

# ===== Catalog dezon.vn =====
CATALOG_PROVIDER=wordpress
CATALOG_BASE_URL=https://dezon.vn
CATALOG_API_USER=
CATALOG_API_APP_PASSWORD=

# ===== Tính năng =====
FEATURE_AI_ENABLED=false
UNANSWERED_ALERT_MIN=15
HANDOFF_ESCALATE_AFTER_MIN=15

# ===== Thông báo =====
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== Giám sát =====
SENTRY_DSN=

# ===== Web (inline vào bundle lúc build image web — đổi thì phải build lại image web) =====
NEXT_PUBLIC_API_URL=https://alo.vuathau.com.vn/api
