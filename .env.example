# ===== Chung =====
NODE_ENV=development
APP_URL=http://localhost:3100
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3100
TZ=Asia/Ho_Chi_Minh
# 32 bytes base64. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Chuỗi ngẫu nhiên >= 32 ký tự
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
LOG_LEVEL=info

# ===== Hạ tầng =====
DATABASE_URL=postgres://dezon:dezon@localhost:5433/dezon_inbox
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=dezon-inbox
S3_ACCESS_KEY=dezon
S3_SECRET_KEY=dezon-s3-secret
S3_REGION=auto
# SeaweedFS/MinIO: true; Cloudflare R2/AWS S3: false
S3_FORCE_PATH_STYLE=true
# Endpoint S3 trình duyệt truy cập được (để trống = S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=
MEDIA_MAX_UPLOAD_MB=10
MEDIA_SIGNED_URL_TTL_SEC=3600
SMTP_URL=smtp://localhost:1025

# ===== Seed (chỉ dùng cho lệnh pnpm db:seed) =====
SEED_ADMIN_EMAIL=admin@dezon.vn
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Quản trị Dezon
# Tùy chọn: tạo thêm 1 tài khoản agent để thử phân quyền
SEED_AGENT_EMAIL=
SEED_AGENT_PASSWORD=

# ===== AI (Giai đoạn 2 trở đi) =====
ANTHROPIC_API_KEY=
AI_MODEL_MAIN=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=
# Phải khớp với kích thước cột vector trong packages/db (1024)
EMBEDDING_DIM=1024
AI_DEBOUNCE_MS=12000
AI_DEBOUNCE_MAX_WAIT_MS=45000
AI_PAUSE_AFTER_AGENT_MIN=30
AI_MIN_CONFIDENCE=0.6
AI_MAX_AUTO_REPLIES_PER_HOUR=20
AI_SEND_HOLDING_MESSAGE=false

# ===== Meta / Messenger (Giai đoạn 1A) =====
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# ⚠️ dùng phiên bản Graph API hiện hành
META_GRAPH_VERSION=v26.0
META_HUMAN_AGENT_ENABLED=false
# Tùy chọn: Configuration ID của Facebook Login for Business (loại token: User access token).
# Để trống => dùng scope pages_show_list,pages_manage_metadata,pages_messaging.
# Valid OAuth Redirect URI cần khai báo: ${API_URL}/channels/messenger/oauth/callback
META_LOGIN_CONFIG_ID=
# Chỉ đổi khi test với Graph API giả lập
META_GRAPH_BASE_URL=https://graph.facebook.com
# Đồng bộ hội thoại qua Conversations API (bổ sung cho webhook)
# Số ngày lịch sử kéo về khi kết nối Page / mặc định của nút "Đồng bộ lịch sử" (1-365)
MESSENGER_HISTORY_DAYS=30
# Chu kỳ đồng bộ định kỳ (giây); 0 = tắt đồng bộ định kỳ (chỉ còn webhook + đồng bộ lịch sử)
MESSENGER_SYNC_INTERVAL_SEC=60
# Chỉ đổi khi test Facebook Login với dialog giả lập (scripts/mock-graph.ts). Trống => https://www.facebook.com
META_LOGIN_DIALOG_BASE_URL=

# ===== Zalo OA (Giai đoạn 1B) =====
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET_KEY=
ZALO_OA_ALLOW_PAID_BOT=false
# Host Zalo (chỉ đổi khi test với Zalo giả lập)
ZALO_OAUTH_BASE_URL=https://oauth.zaloapp.com
ZALO_OPENAPI_BASE_URL=https://openapi.zalo.me
# Thư mục chứa tệp xác thực domain tải từ Zalo; API trả /zalo_verifier<MÃ>.html (đặt tên tệp đúng như vậy)
ZALO_VERIFIER_DIR=./data/zalo-verifier
# Nguồn timeStamp khi kiểm chữ ký webhook: body (trường "timestamp") | header
ZALO_SIGNATURE_TIMESTAMP_SOURCE=body
# Chu kỳ đồng bộ định kỳ (giây); 0 = tắt
ZALO_SYNC_INTERVAL_SEC=60
# Số ngày lịch sử kéo về khi kết nối OA / nút "Đồng bộ lịch sử" (1-365)
ZALO_HISTORY_DAYS=7

# ===== Zalo cá nhân (Giai đoạn 1C) =====
ZALO_PERSONAL_ENABLED=false
ZALO_PERSONAL_MIN_SEND_INTERVAL_MS=3000

# ===== Catalog dezon.vn (Giai đoạn 2) =====
CATALOG_PROVIDER=wordpress
CATALOG_BASE_URL=https://dezon.vn
CATALOG_API_USER=
CATALOG_API_APP_PASSWORD=

# ===== Tính năng =====
FEATURE_AI_ENABLED=false
UNANSWERED_ALERT_MIN=15
HANDOFF_ESCALATE_AFTER_MIN=15

# ===== Thông báo =====
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== Giám sát =====
SENTRY_DSN=

# ===== Web (Next.js, lộ ra trình duyệt) =====
NEXT_PUBLIC_API_URL=http://localhost:4000
